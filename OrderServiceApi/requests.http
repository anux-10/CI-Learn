@base = http://localhost:5211

### Health
GET {{base}}/

### Get all orders
GET {{base}}/orders
Accept: application/json

### Create order
POST {{base}}/orders
Content-Type: application/json

{
  "customerId": "11111111-1111-1111-1111-111111111111",
  "items": [
    {
      "productId": "22222222-2222-2222-2222-222222222222",
      "quantity": 2,
      "unitPrice": 50.00
    },
    {
      "productId": "33333333-3333-3333-3333-333333333333",
      "quantity": 1,
      "unitPrice": 50.00
    }
  ]
}

#### Get order by id (replace with id from create response)
 @orderId = 4ac89405-2678-4e4a-ac3b-e8a62cf4822e
GET {{base}}/orders/{{orderId}}
Accept: application/json

### Pay order
POST {{base}}/orders/{{orderId}}/pay
Content-Type: application/json

{
  "paymentMethod": "CreditCard",
  "cardNumber": "4000000000000000",
  "cardHolderName": "anes user"
}
